# Subscription email delivery through Pat's AgentMail inbox.
# Store AGENTMAIL_API_KEY only in the protected Hermes profile .env.
SYMGOV_EMAIL_TRANSPORT=agentmail
SYMGOV_AGENTMAIL_INBOX=alfi-bot@agentmail.to
SYMGOV_AGENTMAIL_TIMEOUT_SECONDS=20
SYMGOV_SUBSCRIPTION_ADMIN_EMAIL=chris.brighouse@hotmail.co.uk
SYMGOV_EMAIL_WORKER_INTERVAL_SECONDS=30
