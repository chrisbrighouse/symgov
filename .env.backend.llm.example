# SYMGOV LLM Telemetry Environment Configuration Example
# Copy keys to your protected profile .env file (mode 0600)

# LiteLLM Router SDK provider credentials. The central service also accepts
# OPENROUTER_API_KEY, GEMINI_API_KEY, and GOOGLE_API_KEY aliases.
SYMGOV_OPENROUTER_API_KEY=replace-in-protected-env
SYMGOV_GEMINI_API_KEY=replace-in-protected-env

# Optional deployment list. Requests select rows whose model_name equals the
# logical/requested model. Omit this to create one provider deployment lazily.
# LiteLLM callbacks are intentionally forbidden; native telemetry below owns traces.
SYMGOV_LITELLM_MODEL_LIST=[{"model_name":"workspace","litellm_params":{"model":"openrouter/openai/gpt-4o-mini"}},{"model_name":"workspace","litellm_params":{"model":"openrouter/anthropic/claude-3.5-sonnet"}}]

SYMGOV_LLM_TELEMETRY_ENABLED=false
SYMGOV_LLM_TELEMETRY_ENDPOINT=https://cloud.langfuse.com
SYMGOV_LLM_TELEMETRY_PUBLIC_KEY=pk-lf-placeholder
SYMGOV_LLM_TELEMETRY_SECRET_KEY=sk-lf-placeholder
SYMGOV_LLM_TELEMETRY_TIMEOUT_SECONDS=10
SYMGOV_LLM_INITIATOR_HMAC_KEY=secret-hmac-key-placeholder
