# SYMGOV LLM Telemetry Environment Configuration Example
# Copy keys to your protected profile .env file (mode 0600)

SYMGOV_LLM_TELEMETRY_ENABLED=false
SYMGOV_LLM_TELEMETRY_ENDPOINT=https://cloud.langfuse.com
SYMGOV_LLM_TELEMETRY_PUBLIC_KEY=pk-lf-placeholder
SYMGOV_LLM_TELEMETRY_SECRET_KEY=sk-lf-placeholder
SYMGOV_LLM_TELEMETRY_TIMEOUT_SECONDS=10
SYMGOV_LLM_INITIATOR_HMAC_KEY=secret-hmac-key-placeholder
