<?xml version='1.0' encoding='UTF-8'?>
<!--
  Synthetic Proteus XML exercising every primitive `dexpi_converter` supports,
  plus the two shapes it must refuse. Handwritten for the test suite; not
  derived from any DEXPI corpus file, so it carries no third-party licence.

  Coordinates are Y-up, as Proteus declares them, so the converter's Y-flip is
  observable: EVERY_PRIMITIVE_SHAPE's polyline rises to the right.
-->
<PlantModel>
  <PlantInformation Application="Synthetic" ApplicationVersion="1.3.0" Discipline="PID"
                    OriginatingSystem="symgov test fixture" OriginatingSystemVendor="Idox"
                    SchemaVersion="4.1.1" Units="mm">
    <UnitsOfMeasure/>
  </PlantInformation>
  <Drawing Name="fixture">
    <ShapeCatalogue Name="Shapes">

      <Equipment ID="shape-1" ComponentName="EVERY_PRIMITIVE_SHAPE" ComponentClass="Tank">
        <GenericAttributes Set="DexpiAttributes" Number="1">
          <GenericAttribute Name="SymbolRegistrationNumberAssignmentClass"
                            AttributeURI="http://sandbox.dexpi.org/rdl/SymbolRegistrationNumberAssignmentClass"
                            Format="string" Value="ISO10628:2012-9999-A"/>
        </GenericAttributes>
        <Circle Radius="10">
          <Presentation LineType="0" LineWeight="0.3" R="1" G="1" B="1"/>
          <Position>
            <Location X="0" Y="0" Z="0"/>
            <Axis X="0" Y="0" Z="1"/>
            <Reference X="1" Y="0" Z="0"/>
          </Position>
        </Circle>
        <PolyLine NumPoints="2">
          <Presentation LineType="0" LineWeight="0.3" R="0" G="0" B="0"/>
          <Coordinate X="-10" Y="-5"/>
          <Coordinate X="10" Y="5"/>
        </PolyLine>
        <Line>
          <Presentation LineType="Solid" LineWeight="0.3" R="0" G="0" B="0"/>
          <Coordinate X="-10" Y="0"/>
          <Coordinate X="10" Y="0"/>
        </Line>
        <TrimmedCurve StartAngle="0" EndAngle="90">
          <Circle Radius="10">
            <Presentation LineType="0" LineWeight="0.3" R="0" G="0" B="0"/>
            <Position>
              <Location X="0" Y="0" Z="0"/>
              <Axis X="0" Y="0" Z="1"/>
              <Reference X="1" Y="0" Z="0"/>
            </Position>
          </Circle>
        </TrimmedCurve>
        <Shape NumPoints="4" Filled="Solid">
          <Presentation LineType="0" LineWeight="0.2" R="0" G="0" B="0"/>
          <Coordinate X="-2" Y="-2"/>
          <Coordinate X="2" Y="-2"/>
          <Coordinate X="2" Y="2"/>
          <Coordinate X="-2" Y="-2"/>
        </Shape>
        <Text String="T-100" Font="Arial" Justification="CenterCenter" Width="4" Height="3" TextAngle="0">
          <Presentation LineType="Solid" LineWeight="0.2" R="0" G="0" B="0"/>
          <Position>
            <Location X="0" Y="-8"/>
            <Axis X="0" Y="0" Z="1"/>
            <Reference X="1" Y="0" Z="0"/>
          </Position>
        </Text>
      </Equipment>

      <PipingComponent ID="shape-2" ComponentName="ABSURD_LINE_WEIGHT_SHAPE" ComponentClass="BallValve">
        <PolyLine NumPoints="2">
          <Presentation LineType="0" LineWeight="5000" R="0" G="1" B="0"/>
          <Coordinate X="0" Y="0"/>
          <Coordinate X="4" Y="0"/>
        </PolyLine>
      </PipingComponent>

      <PipingComponent ID="shape-3" ComponentName="POINT_ONLY_SHAPE">
        <PolyLine NumPoints="2">
          <Presentation LineType="0" LineWeight="0.3" R="0" G="0" B="0"/>
          <Coordinate X="7" Y="7"/>
          <Coordinate X="7" Y="7"/>
        </PolyLine>
      </PipingComponent>

      <PipingComponent ID="shape-4" ComponentName="NO_GEOMETRY_SHAPE">
        <GenericAttributes Set="DexpiAttributes" Number="1">
          <GenericAttribute Name="Unrelated" Format="string" Value="x"/>
        </GenericAttributes>
      </PipingComponent>

      <PipingComponent ID="shape-5">
        <Circle Radius="1">
          <Presentation LineType="0" LineWeight="0.1" R="0" G="0" B="0"/>
          <Position><Location X="0" Y="0"/></Position>
        </Circle>
      </PipingComponent>

    </ShapeCatalogue>
  </Drawing>
</PlantModel>
